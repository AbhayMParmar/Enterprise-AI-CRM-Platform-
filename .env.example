# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get this from: https://cloud.mongodb.com → Your Cluster → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ai-crm?retryWrites=true&w=majority

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_access_key_here
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=430228513739-cpmej2dicbr46bq1bmngkc42uo1m8rfr.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── Groq AI (LLaMA-3) ────────────────────────────────────────────────────────
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# ─── Redis (optional — used for session caching) ──────────────────────────────
# Use Upstash Redis for serverless: https://upstash.com
REDIS_URL=redis://localhost:6379
# Or for Upstash:
# REDIS_URL=rediss://:password@your-redis.upstash.io:6379

# ─── Cloudinary (Avatar Uploads) ──────────────────────────────────────────────
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Email / SMTP (Nodemailer) ────────────────────────────────────────────────
# Used for: Forgot Password OTP emails ONLY (not login, not registration)
# For Gmail: enable 2FA → Google Account → Security → App Passwords
#
# Both naming conventions are supported (use either set):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=AI CRM Platform <noreply@yourapp.com>
#
# Alternatively:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_gmail_app_password
# EMAIL_FROM=AI CRM Platform <noreply@yourapp.com>
#
# OTP expires in 2 minutes. Resend cooldown: 60 seconds. Max attempts: 5.

# ─── CORS / Client URL ────────────────────────────────────────────────────────
# Your Vercel frontend URL (e.g. https://your-app.vercel.app)
CLIENT_URL=https://your-app.vercel.app
